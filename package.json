{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preinstall": "node scripts/ensure-pnpm.cjs",
    "build": "node scripts/host-scripts.cjs build",
    "start": "node scripts/host-scripts.cjs start",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts/**\" --if-present run typecheck",
    "android": "pnpm --filter @workspace/mobile run android",
    "ios": "pnpm --filter @workspace/mobile run ios",
    "start:web": "pnpm --filter @workspace/mobile run start:web"
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "@replit/connectors-sdk": "^0.4.1",
    "eas-cli": "^22.2.0",
    "expo": "~54.0.36",
    "expo-image": "~3.0.11",
    "lottie-react-native": "^7.3.1",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "prettier": "^3.9.5",
    "typescript": "~5.9.3"
  }
}
