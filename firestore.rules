rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── 1. PLAYERS PROFILE COLLECTION ───────────────────────────────────────
    // Path: players/{uid}
    match /players/{uid} {
      // Only the authenticated user can read or write their own core profile data
      allow read, write: if request.auth != null && request.auth.uid == uid;
      
      // ─── Subcollection: Purchases (Phase 2 §2) ────────────────────────────
      // Path: players/{uid}/purchases/{transactionId}
      match /purchases/{transactionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      
      // ─── Subcollection: Spin Wheel History (Phase 3) ──────────────────────
      // Path: players/{uid}/spinHistory/{autoId}
      match /spinHistory/{spinId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      
      // ─── Subcollection: Private Data Secure Vault ─────────────────────────
      // Path: players/{uid}/private/pushToken
      match /private/pushToken {
        // Only the authenticated device owner can write/update their own token.
        // Client reads are strictly forbidden (Deny-All) to protect user privacy.
        // The server-side cloud function Admin SDK retains full backend access.
        allow write: if request.auth != null && request.auth.uid == uid;
        allow read: if false;
      }
    }

    // ─── 2. GAME SESSIONS COLLECTION ─────────────────────────────────────────
    // Path: game_sessions/{sessionId}
    match /game_sessions/{sessionId} {
      // Allow creation of a session only if the logged-in user matches the playerId field
      allow create: if request.auth != null && request.resource.data.playerId == request.auth.uid;
      
      // Allow reading or updating only if the existing document belongs to the active user
      allow read, update, delete: if request.auth != null && resource.data.playerId == request.auth.uid;
    }

  }
}
