rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Guest (anonymous) and Google may own a player id. Dollar purchases are
    // Google-only and live in purchase_ledger, which clients can never delete.
    function isGoogleUser(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isSignedInPlayer(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && (request.auth.token.firebase.sign_in_provider == 'google.com'
            || request.auth.token.firebase.sign_in_provider == 'anonymous');
    }

    // ─── 1. PLAYERS PROFILE = gameplay progress ──────────────────────────────
    // Path: players/{uid}
    match /players/{uid} {
      allow read: if isSignedInPlayer(uid);

      // Clients may create/update their own profile, but `nickname`,
      // `nicknameNormalized`, and `username` are identity fields that only
      // the server (via the Admin SDK in /api/nickname/register, which
      // bypasses these rules) is allowed to set. This stops a client from
      // writing an unregistered/duplicate display name straight into
      // Firestore and bypassing the uniqueness reservation entirely.
      allow create: if isSignedInPlayer(uid)
        && !('nickname' in request.resource.data)
        && !('nicknameNormalized' in request.resource.data)
        && !('username' in request.resource.data);

      allow update: if isSignedInPlayer(uid)
        && request.resource.data.get('nickname', null) == resource.data.get('nickname', null)
        && request.resource.data.get('nicknameNormalized', null) == resource.data.get('nicknameNormalized', null)
        && request.resource.data.get('username', null) == resource.data.get('username', null);

      // Legacy purchase subcollection — new dollar records go to purchase_ledger.
      match /purchases/{transactionId} {
        allow read, write: if isGoogleUser(uid);
      }

      match /spinHistory/{spinId} {
        allow read, write: if isSignedInPlayer(uid);
      }

      match /private/pushToken {
        allow write: if isSignedInPlayer(uid);
        allow read: if false;
      }
    }

    // ─── 1b. NICKNAMES COLLECTION ─────────────────────────────────────────────
    match /nicknames/{normalizedNickname} {
      allow read, write: if false;
    }

    // ─── 1c. DOLLAR PURCHASE LEDGER (never deleted by account deletion) ──────
    // Path: purchase_ledger/{transactionId}
    match /purchase_ledger/{transactionId} {
      allow read: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && resource.data.playerId == request.auth.uid;
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.resource.data.playerId == request.auth.uid
        && request.resource.data.transactionId == transactionId;
      allow update, delete: if false;
    }

    // ─── 2. GAME SESSIONS COLLECTION ─────────────────────────────────────────
    match /game_sessions/{sessionId} {
      allow create: if isSignedInPlayer(request.resource.data.playerId);
      allow read, update, delete: if isSignedInPlayer(resource.data.playerId);
    }

  }
}
