# ── GUESSAi environment variables ────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# Variables prefixed EXPO_PUBLIC_ are inlined at build time and visible in JS.

# ── AdMob (optional — app uses test IDs when these are absent) ────────────────
EXPO_PUBLIC_ADMOB_BANNER_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=
EXPO_PUBLIC_ADMOB_REWARDED_ID=

# ── Replit dev server (set automatically by the pnpm dev script) ──────────────
EXPO_PUBLIC_DOMAIN=
EXPO_PUBLIC_REPL_ID=
