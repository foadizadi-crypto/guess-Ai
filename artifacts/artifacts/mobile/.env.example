# ── GUESSAi environment variables ────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# Variables prefixed EXPO_PUBLIC_ are inlined at build time and visible in JS.

# ── API ───────────────────────────────────────────────────────────────────────
# Production EAS builds MUST set this to the public HTTPS API origin.
EXPO_PUBLIC_API_URL=https://guess-ai-4sqt.onrender.com
EXPO_PUBLIC_ENV=development

# ── AdMob ─────────────────────────────────────────────────────────────────────
# Leave blank to disable ads in release (test IDs are never shipped as live ads).
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_BANNER_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=
EXPO_PUBLIC_ADMOB_REWARDED_ID=

# ── Google Sign-In ────────────────────────────────────────────────────────────
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=593305587333-3ths0ajkbvnafscim6igcuki56sesvlh.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=593305587333-250mi4l6t3terntac2e9imen18it8mpt.apps.googleusercontent.com

# ── Legal (Play Console also needs a public HTTPS privacy policy URL) ─────────
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
